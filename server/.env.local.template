# Local end-to-end testing config for the AI-first release.
#
# HOW TO USE
#   1. Copy this file to server/.env  (that name is gitignored — this template is not,
#      so never put real secrets in this file).
#   2. Fill in the two <PLACEHOLDER> values below.
#   3. Tell me it's ready and I'll run the migrations, seed, and drive the
#      resident / admin / guard flows against it.
#
# Nothing here leaves your machine, and .env is never committed.

PORT=4000
JWT_SECRET=local-dev-only-not-a-real-secret-just-needs-to-be-long

# ------------------------------------------------------------------------------
# 1) DATABASE — the PostgreSQL 17 that was just installed locally.
#
# Replace <POSTGRES_PASSWORD> with the superuser password from the install.
# If you never set one, reset it from an ADMIN PowerShell:
#     & "C:\Program Files\PostgreSQL\17\bin\psql.exe" -U postgres -c "ALTER USER postgres PASSWORD 'gatemate';"
# ...and if that itself asks for a password you don't have, say so and I'll walk
# you through the pg_hba.conf reset.
#
# The gatemate database is created for you before the first run.
DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@127.0.0.1:5432/gatemate

# ------------------------------------------------------------------------------
# 2) AI — needed to test the assistant and the guard's voice entry for real.
#
# Groq is free and covers both chat and Whisper voice. Either reuse the key from
# the Render dashboard (Environment -> AI_API_KEY) or make a new one at
# https://console.groq.com -> API Keys.
#
# Do NOT use llama-3.3-70b-versatile — Groq retired it on 2026-08-16. The server
# now falls back automatically, but starting on a live id skips a wasted call.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=<GROQ_API_KEY>
AI_CHAT_MODEL=openai/gpt-oss-120b
AI_TRANSCRIBE_MODEL=whisper-large-v3

# ------------------------------------------------------------------------------
# Everything below is optional and deliberately left off for local testing.
# Visitor photos fall back to placeholder avatars, payments stay in test mode,
# and password-reset codes print to the server console instead of being emailed.
BACKUP_CRON_ENABLED=false
PLATFORM_BACKUP_CRON_ENABLED=false
