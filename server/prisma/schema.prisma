// H2O society app database schema.
// PostgreSQL (Supabase in production). Roles/statuses are kept as plain strings
// for portability rather than DB enums.
// Allowed values:
//   User.role      : "superadmin" | "admin" | "guard" | "resident"
//   Bill.status    : "pending"  | "paid"
//   Visitor.status : "pending"  | "approved" | "rejected" | "leave_at_gate"
//
// Multi-tenancy: every society is a Society. Flats, users (admin/guard/resident),
// expenses and the bank account belong to exactly one society. Bills and visitors
// are scoped through their flat. The "superadmin" (H2O platform owner) has no
// society (societyId = null) and can see/manage every society.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Society {
  id            String           @id @default(uuid())
  name          String
  city          String?
  address       String?
  active        Boolean          @default(true)
  // URL-friendly unique handle (e.g. "little-millennium"). Used for per-tenant
  // branded login links / QR codes: <app>/?t=<slug> or h2o://?t=<slug>.
  slug          String?          @unique
  // Short human-friendly code (e.g. "GM7K2Q") residents type to self-register
  // into THIS tenant. Admin can rotate it. Self-registered users land in a
  // pending-approval state until an admin approves them.
  joinCode      String?          @unique
  // Tenant type: "society" (default, unchanged behavior) or "preschool"
  // (school-flavored labels + entry/exit & staff attendance features).
  orgType       String           @default("society")
  // Optional tenant logo (image URL). Shown in-app after login so each
  // tenant's staff/residents see their own brand (name + logo).
  logoUrl       String?
  // Subscription plan: "free" | "premium". Premium is a yearly paid plan set by
  // the H2O superadmin; unlocks perks like the vendor venue marketplace & voice AI.
  plan          String           @default("free")
  planExpiresAt DateTime?
  planAmount    Float?           // agreed yearly subscription amount (INR)
  planNote      String?
  // Customer-facing product tier: "base" | "prime" | "platinum". Set by the
  // GateMate superadmin; drives which features are unlocked in the app. Defaults
  // to "platinum" so existing tenants keep all features until explicitly tiered.
  tier          String           @default("platinum")
  createdAt     DateTime         @default(now())
  flats         Flat[]
  users         User[]
  expenses      Expense[]
  accounts      SocietyAccount[]
  announcements Announcement[]
  posts         Post[]
  amenities     Amenity[]
  bookings      Booking[]
  venueBookings VenueBooking[]
  staffAttendance StaffAttendance[]
  tickets       Ticket[]
  billingSetting BillingSetting?
  maintenanceHeads MaintenanceHead[]
  gatePasses    GatePass[]
  listings      Listing[]
  vehicles      Vehicle[]
  gateDevices   GateDevice[]
  vehicleEntries VehicleEntry[]
}

// A commercial booking of a society premise by an OUTSIDE vendor (not a resident):
// e.g. a decorator or event company books the community hall/ground for a day.
// The vendor pays the society; H2O takes a platform fee (default 10%).
model VenueBooking {
  id             String    @id @default(uuid())
  society        Society   @relation(fields: [societyId], references: [id], onDelete: Cascade)
  societyId      String
  venueName      String
  vendorName     String
  vendorPhone    String?
  vendorEmail    String?
  purpose        String?
  date           String // "2026-07-25"
  slot           String    @default("full_day") // full_day | half_day | custom label
  amount         Float     @default(0)
  platformFeePct Float     @default(10)
  platformFee    Float     @default(0)
  societyNet     Float     @default(0)
  // requested | approved | rejected | paid | completed | cancelled
  status         String    @default("requested")
  paymentRef     String?
  paidAt         DateTime?
  notes          String?
  createdBy      String?
  // Razorpay Payment Link the vendor pays; on payment, societyNet (90%) is
  // routed to the society's linked account and H2O keeps the platform fee.
  paymentLinkId  String?
  paymentLinkUrl String?
  createdAt      DateTime  @default(now())

  @@index([societyId])
}

model Flat {
  id        String    @id @default(uuid())
  society   Society   @relation(fields: [societyId], references: [id], onDelete: Cascade)
  societyId String
  // For societies this is the flat/unit number; for preschools it is the
  // student's name/roll. `block` doubles as the wing (society) or class (preschool).
  flatNo    String
  block     String?
  ownerName String?
  // Occupancy: "owner" (default) or "rented". Rented flats can have a different
  // monthly maintenance and can hold a rent agreement that the admin verifies.
  occupancy String @default("owner")
  // Optional override for the monthly maintenance charged to a RENTED flat.
  // When set and occupancy = "rented", bill generation uses this instead of the
  // society-wide amount. Null = use the standard amount.
  rentMaintenanceAmount Float?
  // Preschool: the child's guardian/parent contact used for fee reminders even
  // when no parent login exists yet. Ignored for societies.
  guardianName  String?
  guardianPhone String?
  guardianEmail String?
  residents User[]
  bills     Bill[]
  visitors  Visitor[]
  agreements RentAgreement[]
  gatePasses GatePass[]
  vehicles  Vehicle[]
  createdAt DateTime  @default(now())

  // Flat numbers are unique within a society (two societies may both have A-101).
  @@unique([societyId, flatNo])
  @@index([societyId])
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  phone         String?
  passwordHash  String
  role          String
  // Society this user belongs to. Null only for the platform superadmin.
  society       Society?  @relation(fields: [societyId], references: [id], onDelete: Cascade)
  societyId     String?
  flat          Flat?     @relation(fields: [flatId], references: [id])
  flatId        String?
  expoPushToken String?
  active        Boolean   @default(true)
  // Set when a resident self-registers with the society join code. They cannot
  // log in until an admin approves them (flips this back to false).
  pendingApproval Boolean @default(false)
  // Whether this user wants push notifications (visitor alerts, reminders, etc.).
  notifyEnabled Boolean   @default(true)
  // Whether this resident agrees to show their phone in the society member
  // directory. Residents can opt out from their profile. Defaults to visible.
  sharePhone    Boolean   @default(true)
  // SOS "neighbour mesh": residents can opt in as an emergency responder (e.g. a
  // doctor/nurse/first-aider) so a panic alert also reaches them, and choose to
  // share their in-society location when they respond.
  isResponder    Boolean  @default(false)
  responderSkill String?           // doctor | nurse | first_aid | security | other
  shareLocation  Boolean  @default(false)
  createdAt     DateTime  @default(now())
  // Self-service password reset via emailed OTP.
  resetOtpHash      String?
  resetOtpExpiresAt DateTime?
  resetOtpAttempts  Int      @default(0)
  // Visitors this user (a guard) logged at the gate.
  loggedVisitors Visitor[] @relation("GuardVisitors")
  // Community board posts authored by this user.
  posts         Post[]
  // Amenity/clubhouse bookings made by this resident.
  bookings      Booking[] @relation("ResidentBookings")
  // Helpdesk tickets raised by this user.
  tickets       Ticket[]  @relation("TicketAuthor")
  // Gate passes this resident created for expected guests/deliveries.
  gatePasses    GatePass[] @relation("GatePassCreator")
  // Buy & Sell listings authored + messages sent about others' listings.
  listings      Listing[]  @relation("ListingAuthor")
  listingMessages ListingMessage[] @relation("ListingMsgFrom")
  listingJoins  ListingJoin[] @relation("ListingJoinUser")

  // societyId+role: directory & admin/guard lookups. flatId: fast push targeting
  // (notify a flat's residents) and "residents of this flat" reads.
  @@index([societyId, role])
  @@index([flatId])
}

model Bill {
  id         String    @id @default(uuid())
  flat       Flat      @relation(fields: [flatId], references: [id], onDelete: Cascade)
  flatId     String
  period     String // e.g. "2026-07"
  amount     Float // total amount due for this bill
  dueDate    String // e.g. "2026-07-10"
  // "pending" | "partial" (some paid) | "paid" (fully settled).
  status     String    @default("pending")
  // Cumulative amount received so far (supports partial / installment payments).
  paidAmount Float     @default(0)
  // Preschool fees: the next installment the guardian is asked to pay now
  // (e.g. pay 15k of a 30k balance) and the date a reminder should be sent.
  nextDueAmount  Float?
  remindOn       String?  // "YYYY-MM-DD"; a reminder is auto-sent on/after this date
  lastRemindedAt DateTime?
  paidAt     DateTime?
  paymentRef String?
  orderId    String?
  // Late fee currently accrued on this bill (0 unless overdue past the grace
  // period). Recomputed lazily; always 0 once the bill is fully paid, so an
  // advance / on-time payment can never pick up a late fee by mistake.
  lateFee    Float     @default(0)
  // Optional per-head breakdown snapshot ([{ head, amount }]) captured when the
  // bill was generated, so receipts can show Maintenance / Sinking fund / etc.
  breakdown  Json?
  // How the bill was settled: "online" (Razorpay/mock) or "cash" (recorded by admin).
  paymentMode   String?
  // For cash payments: who collected it (society member) and their phone.
  collectedBy   String?
  collectorPhone String?
  payments   Payment[]
  createdAt  DateTime  @default(now())

  // flatId+period: per-flat ledger & month-scoped bill generation.
  // status: reminder sweeps and paid/pending aggregation.
  @@index([flatId, period])
  @@index([status])
}

// Ledger of individual payments against a bill (enables partial/installment
// payments and a full payment history per student/flat).
model Payment {
  id             String   @id @default(uuid())
  bill           Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  billId         String
  amount         Float
  mode           String   @default("online") // online | cash
  ref            String?
  collectedBy    String?  // for cash: who collected it
  collectorPhone String?
  createdAt      DateTime @default(now())

  @@index([billId])
}

// A rent/lease agreement for a RENTED flat. A resident (tenant/owner) submits it
// from the app with the lease dates and an optional uploaded document; the admin
// verifies it. As the end date approaches, early reminders and an on-expiry notice
// are sent to the admin, owner and tenant. Only relevant for flats marked rented.
model RentAgreement {
  id          String   @id @default(uuid())
  flat        Flat     @relation(fields: [flatId], references: [id], onDelete: Cascade)
  flatId      String
  // Denormalized for cheap society-scoped queries and cron sweeps.
  societyId   String
  tenantName  String
  tenantPhone String?
  tenantEmail String?
  ownerName   String?
  ownerPhone  String?
  startDate   String // "YYYY-MM-DD"
  endDate     String // "YYYY-MM-DD"
  rentAmount  Float?
  // Uploaded agreement document (public URL from storage) + original file name.
  documentUrl  String?
  documentName String?
  // "pending" (awaiting admin) | "verified" | "rejected" | "expired"
  status          String   @default("pending")
  verifiedBy      String?
  verifiedAt      DateTime?
  rejectionReason String?
  // Expiry-reminder bookkeeping so each stage fires once:
  // null -> "T-30" -> "T-15" -> "T-7" -> "expired".
  lastNotifiedStage String?
  lastNotifiedAt    DateTime?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([flatId])
  @@index([societyId])
  @@index([status])
}

model Visitor {
  id        String    @id @default(uuid())
  flat      Flat      @relation(fields: [flatId], references: [id], onDelete: Cascade)
  flatId    String
  name      String
  phone     String?
  vehicleNo String?
  purpose   String?
  photoUrl  String?
  guard     User?     @relation("GuardVisitors", fields: [guardId], references: [id])
  guardId   String?
  status    String    @default("pending")
  decidedBy String?
  createdAt DateTime  @default(now())
  decidedAt DateTime?
  // Gate exit timestamp (entry/exit tracking; used by preschools especially).
  exitAt    DateTime?
  exitBy    String?

  // flatId+createdAt: resident timeline & society gate log ordered by recency.
  @@index([flatId, createdAt])
}

// Staff/teacher gate attendance (check-in / check-out). Used by preschool
// tenants; scoped per society and per day.
model StaffAttendance {
  id        String    @id @default(uuid())
  society   Society   @relation(fields: [societyId], references: [id], onDelete: Cascade)
  societyId String
  name      String
  role      String?   // teacher | helper | security | admin-staff | other
  phone     String?
  date      String // "2026-07-22"
  inAt      DateTime  @default(now())
  outAt     DateTime?
  markedBy  String?
  createdAt DateTime  @default(now())

  @@index([societyId, date])
}

model Expense {
  id        String   @id @default(uuid())
  society   Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)
  societyId String
  label     String
  amount    Float
  date      DateTime @default(now())
  createdBy String?
  createdAt DateTime @default(now())

  @@index([societyId])
}

// A society's bank account that maintenance collections are routed to (one per
// society). razorpayAccountId is a Razorpay Route "Linked Account" id
// (acc_XXXXXXXX); when set, each maintenance order transfers its full amount to it.
model SocietyAccount {
  id                String   @id @default(uuid())
  society           Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)
  societyId         String
  accountHolderName String
  bankName          String?
  accountNumber     String?
  ifsc              String?
  upiId             String?
  razorpayAccountId String?
  active            Boolean  @default(true)
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([societyId])
}

// Society announcements posted by admins; visible to everyone in the society.
model Announcement {
  id        String   @id @default(uuid())
  society   Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)
  societyId String
  title     String
  body      String
  pinned    Boolean  @default(false)
  createdBy String? // admin user id
  authorName String?
  createdAt DateTime @default(now())

  @@index([societyId])
}

// Community board posts by residents (sell items, queries, info). Admin can delete.
model Post {
  id         String   @id @default(uuid())
  society    Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)
  societyId  String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId   String
  // "general" | "sale" | "query" | "lost_found" | "recommend"
  category   String   @default("general")
  title      String
  body       String
  price      Float?
  createdAt  DateTime @default(now())

  @@index([societyId])
  @@index([authorId])
}

// Helpdesk ticket raised by a resident (complaint / maintenance request / query).
// The society admin (manager) gets notified, replies via comments, and marks it
// resolved with a closing note. Residents track status + full history.
model Ticket {
  id          String          @id @default(uuid())
  society     Society         @relation(fields: [societyId], references: [id], onDelete: Cascade)
  societyId   String
  author      User            @relation("TicketAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId    String
  flatId      String?
  // plumbing | electrical | housekeeping | security | billing | general | other
  category    String          @default("general")
  // low | normal | high
  priority    String          @default("normal")
  subject     String
  description String
  // open | in_progress | resolved
  status      String          @default("open")
  resolution  String?
  resolvedById String?
  resolvedAt  DateTime?
  comments    TicketComment[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([societyId])
  @@index([authorId])
  @@index([status])
}

// A message in a ticket thread (resident <-> admin back-and-forth + history).
model TicketComment {
  id         String   @id @default(uuid())
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId   String
  authorId   String
  authorName String?
  authorRole String?  // resident | admin | guard
  body       String
  createdAt  DateTime @default(now())

  @@index([ticketId])
}

// A bookable society amenity (clubhouse, party hall, etc.). Disabled by default;
// an admin enables it. Each amenity has time slots with a price.
model Amenity {
  id          String        @id @default(uuid())
  society     Society       @relation(fields: [societyId], references: [id], onDelete: Cascade)
  societyId   String
  name        String
  description String?
  enabled     Boolean       @default(false)
  createdAt   DateTime      @default(now())
  slots       AmenitySlot[]
  bookings    Booking[]

  @@index([societyId])
}

model AmenitySlot {
  id        String    @id @default(uuid())
  amenity   Amenity   @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  amenityId String
  label     String // Morning / Afternoon / Evening / custom
  startTime String? // e.g. "09:00"
  endTime   String? // e.g. "12:00"
  price     Float     @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  bookings  Booking[]

  @@index([amenityId])
}

// A resident's booking of a slot on a date. Flow:
//   requested -> approved -> paid (booked)   |   rejected / cancelled
model Booking {
  id         String      @id @default(uuid())
  society    Society     @relation(fields: [societyId], references: [id], onDelete: Cascade)
  societyId  String
  amenity    Amenity     @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  amenityId  String
  slot       AmenitySlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  slotId     String
  resident   User        @relation("ResidentBookings", fields: [residentId], references: [id], onDelete: Cascade)
  residentId String
  flatId     String?
  date       String // "2026-07-25"
  status     String      @default("requested")
  amount     Float       @default(0)
  notes      String?
  orderId    String?
  paymentRef String?
  paidAt     DateTime?
  decidedBy  String?
  decidedAt  DateTime?
  createdAt  DateTime    @default(now())

  @@index([societyId])
  @@index([slotId, date])
}

// Platform-level (H2O owner) settings: the contact email that platform emails
// use, and H2O's own bank/UPI details shown to society admins for reference.
// Singleton row with a fixed id ("platform").
model PlatformSetting {
  id            String   @id @default("platform")
  contactEmail  String?
  bankName      String?
  accountName   String?
  accountNumber String?
  ifsc          String?
  upiId         String?
  updatedBy     String?
  updatedAt     DateTime @updatedAt @default(now())
}

// A subscription payment made by a society/preschool to H2O (the platform).
// Settles to H2O's own Razorpay account. societyId is a scalar snapshot so the
// record survives even if the society is later removed.
model PlatformPayment {
  id          String   @id @default(uuid())
  societyId   String
  societyName String?
  amount      Float
  orderId     String?
  paymentRef  String?
  periodLabel String?
  status      String   @default("paid")
  createdBy   String?
  paidAt      DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([societyId])
}

// Per-society billing policy. Currently holds the late-fee rule applied to
// overdue maintenance/fee bills. One row per society.
model BillingSetting {
  id               String  @id @default(uuid())
  society          Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  societyId        String  @unique
  lateFeeEnabled   Boolean @default(false)
  // "flat" (once past due) | "perday" (per day overdue) | "percent" (of balance / month)
  lateFeeType      String  @default("flat")
  lateFeeAmount    Float   @default(0)
  lateFeeGraceDays Int     @default(0)
  // Optional cap for perday/percent accrual (0 / null = no cap).
  lateFeeMaxAmount Float?
  updatedBy        String?
  updatedAt        DateTime @updatedAt @default(now())
}

// A configurable component ("head") of the monthly maintenance bill, e.g.
// Maintenance, Sinking fund, Water bill, Common area. Society-wide amount.
model MaintenanceHead {
  id        String  @id @default(uuid())
  society   Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  societyId String
  name      String
  amount    Float   @default(0)
  enabled   Boolean @default(true)
  isDefault Boolean @default(false)
  sortOrder Int     @default(0)
  createdAt DateTime @default(now())

  @@index([societyId])
}

// A pre-approved gate pass a resident creates for an expected guest / delivery /
// cab. The guard admits them by the short code within the validity window
// (MyGate-style pre-approval), without disturbing the resident.
model GatePass {
  id            String    @id @default(uuid())
  society       Society   @relation(fields: [societyId], references: [id], onDelete: Cascade)
  societyId     String
  flat          Flat?     @relation(fields: [flatId], references: [id], onDelete: SetNull)
  flatId        String?
  createdBy     User      @relation("GatePassCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdById   String
  guestName     String
  guestPhone    String?
  vehicleNo     String?
  // guest | delivery | cab | service | other
  type          String    @default("guest")
  purpose       String?
  code          String
  validFrom     DateTime  @default(now())
  validUntil    DateTime
  // active | used | expired | cancelled
  status        String    @default("active")
  usedAt        DateTime?
  usedByGuardId String?
  createdAt     DateTime  @default(now())

  @@index([societyId, code])
  @@index([societyId, status])
}

// A Buy & Sell marketplace listing posted by a resident. Visibility is either
// "society" (own society only) or "all" (visible to residents of every society).
model Listing {
  id          String           @id @default(uuid())
  society     Society          @relation(fields: [societyId], references: [id], onDelete: Cascade)
  societyId   String
  author      User             @relation("ListingAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId    String
  title       String
  description String
  price       Float?
  // furniture | electronics | vehicles | home_decor | kids | food | services | others
  category    String           @default("others")
  // sale | borrow | skill | group_buy  — the "circular economy" listing types.
  kind        String           @default("sale")
  lendMode    String?          // borrow kind: lend | borrow | free
  targetCount Int?             // group_buy: participants needed to unlock the deal
  unitPrice   Float?           // group_buy: price per unit at the target
  deadline    DateTime?        // group_buy: join-by date
  images      Json?            // array of image URLs
  location    String?          // free-text (society/area) shown on the card
  visibility  String           @default("all") // all | society
  // active | sold | removed | fulfilled
  status      String           @default("active")
  messages    ListingMessage[]
  joins       ListingJoin[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, visibility])
  @@index([kind, status])
  @@index([societyId])
  @@index([authorId])
}

// A resident joining a group-buy (or expressing interest in a borrow/lend).
model ListingJoin {
  id        String   @id @default(uuid())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  user      User     @relation("ListingJoinUser", fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  name      String?
  flatNo    String?
  qty       Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([listingId, userId])
  @@index([listingId])
}

// Audit log of platform / society backups (for the superadmin's Backup &
// recovery panel and the disaster-recovery runbook).
model BackupLog {
  id        String   @id @default(uuid())
  kind      String   @default("platform") // platform | society
  societyId String?
  at        DateTime @default(now())
  sizeBytes Int?
  sha256    String?
  url       String?  // signed download URL (may be time-limited)
  encrypted Boolean  @default(false)
  ok        Boolean  @default(true)
  note      String?
  stats     Json?

  @@index([kind, at])
}

// A message from an interested buyer to a listing's owner.
model ListingMessage {
  id        String   @id @default(uuid())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  from      User     @relation("ListingMsgFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  fromUserId String
  fromName  String?
  body      String
  createdAt DateTime @default(now())

  @@index([listingId])
}

// ---- Platinum: automated vehicle gate (RFID / ANPR / QR) ----

// A resident vehicle registered to a flat. Each carries an opaque, revocable
// `code` that is encoded into a printable QR and/or matched by the gate scanner.
model Vehicle {
  id        String   @id @default(uuid())
  society   Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)
  societyId String
  flat      Flat?    @relation(fields: [flatId], references: [id], onDelete: SetNull)
  flatId    String?
  type      String   @default("car") // car | bike | other
  plate     String                    // stored uppercased for display + matching
  ownerName String?
  code      String   @unique          // opaque code encoded in the QR (revocable)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  entries   VehicleEntry[]

  @@index([societyId])
  @@index([flatId])
}

// A physical gate scanner/controller installed at a society entry lane. It
// authenticates to /gate/verify and /gate/whitelist using its `deviceKey`.
model GateDevice {
  id         String    @id @default(uuid())
  society    Society   @relation(fields: [societyId], references: [id], onDelete: Cascade)
  societyId  String
  name       String
  deviceKey  String    @unique
  location   String?
  active     Boolean   @default(true)
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  entries    VehicleEntry[]

  @@index([societyId])
}

// A log row for every gate read (open or deny), for audit + resident notifications.
model VehicleEntry {
  id        String   @id @default(uuid())
  society   Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)
  societyId String
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleId String?
  device    GateDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  deviceId  String?
  plate     String?
  code      String?
  direction String?  // in | out
  decision  String   // open | deny
  reason    String?
  at        DateTime @default(now())

  @@index([societyId, at])
  // Anti-passback / clone detection reads the vehicle's most recent open on
  // every scan — index by (vehicleId, at) so that lookup stays O(1)-ish.
  @@index([vehicleId, at])
}

// Daily-help & helpline directory (maid, electrician, doctor, ambulance, MSEB…).
// Three layers, distinguished by `scope`:
//   "platform" : GateMate-curated, societyId = null, visible to EVERY society.
//   "society"  : added by a society admin, visible to that society's residents.
//   "personal" : added by a resident (ownerId set), visible only to that owner
//                UNLESS suggested to the society (status = "suggested" until an
//                admin approves it, which flips it to a published society entry).
// Kept relation-less (plain scalar ids) so lists filter by societyId/ownerId
// without joins; suggestedByName is denormalized to render approval cards.
model ServiceContact {
  id            String   @id @default(uuid())
  scope         String   @default("society") // platform | society | personal
  societyId     String?                       // null for platform-curated
  ownerId       String?                       // set for personal / suggested entries
  category      String                        // helpers|trades|medical|utilities|emergency|lifestyle
  subtype       String?                       // free label e.g. "Maid","Electrician","Ambulance"
  name          String
  phone         String?
  altPhone      String?
  note          String?
  featured      Boolean  @default(false)      // sponsored / pinned to top
  status        String   @default("published")// published | suggested | hidden
  suggestedById String?                       // resident who suggested a society entry
  suggestedByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([societyId, category])
  @@index([scope, category])
  @@index([ownerId])
  @@index([societyId, status])
  // Optional link to a portable Worker identity (Trust Passport). When set, the
  // society contact card can surface the worker's network-wide rating.
  workerId      String?
  @@index([workerId])
}

// ---- SOS "neighbour mesh" (panic button + responder network) ----
// A resident's panic alert. Reaches guards, admins and opted-in responders; any
// nearby responder can acknowledge ("I'm coming"). One-tap ambulance pulls the
// number from the emergency helplines catalog.
model SosAlert {
  id           String        @id @default(uuid())
  societyId    String
  raisedById   String
  raiserName   String?
  raiserFlatNo String?
  type         String        @default("medical") // medical | security | fire | other
  note         String?
  lat          Float?
  lng          Float?
  status       String        @default("active")  // active | resolved | cancelled
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime      @default(now())
  responses    SosResponse[]

  @@index([societyId, status])
}

// A responder's acknowledgement of an SOS alert.
model SosResponse {
  id            String   @id @default(uuid())
  alert         SosAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  alertId       String
  responderId   String
  responderName String?
  skill         String?
  message       String?
  createdAt     DateTime @default(now())

  @@index([alertId])
}

// ---- Preschool pickup-safety + live child updates ----
// A person a parent authorizes to pick up their child. Each carries a QR `code`
// the guard scans at the gate; only an authorized person (within any validity
// window) may collect the child, and every pickup is logged.
model PickupAuthorization {
  id          String    @id @default(uuid())
  societyId   String
  flatId      String    // the "student" (Flat) this authorization is for
  name        String
  phone       String?
  relation    String?   // Parent | Grandparent | Driver | Relative | Other
  photoUrl    String?
  code        String    @unique
  active      Boolean   @default(true)
  validFrom   DateTime?
  validUntil  DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([societyId, flatId])
}

// A logged child pickup (or drop) at the gate.
model PickupEvent {
  id              String   @id @default(uuid())
  societyId       String
  flatId          String
  authorizationId String?
  personName      String
  personPhone     String?
  relation        String?
  kind            String   @default("pickup") // pickup | drop
  photoUrl        String?
  byGuardId       String?
  byGuardName     String?
  at              DateTime @default(now())

  @@index([societyId, at])
  @@index([flatId, at])
}

// A live update a teacher/admin posts about a child (meal, nap, mood, activity,
// note). Parents see their own child's timeline.
model ChildUpdate {
  id        String   @id @default(uuid())
  societyId String
  flatId    String
  type      String   @default("note") // meal | nap | mood | activity | note | health
  mood      String?                    // happy | okay | upset (optional)
  text      String
  byId      String?
  byName    String?
  at        DateTime @default(now())

  @@index([societyId, at])
  @@index([flatId, at])
}

// Tamper-evident financial audit chain (one hash-linked log per society). Every
// money event (payment in, expense out) is appended with a running SHA-256 that
// includes the previous entry's hash — so any silent edit/delete of history
// breaks the chain and is detectable. Powers the resident-facing Transparency
// Score. Entries are append-only; `seq` is a per-society monotonically
// increasing counter.
model LedgerEntry {
  id        String   @id @default(uuid())
  societyId String
  seq       Int
  type      String   // payment | expense | adjustment
  refId     String?  // Payment.id / Expense.id it snapshots
  direction String   // in | out
  amount    Float    @default(0)
  label     String?
  at        DateTime @default(now())
  prevHash  String   @default("")
  hash      String
  meta      Json?
  createdAt DateTime @default(now())

  @@unique([societyId, seq])
  @@index([societyId, at])
}

// ---- Portable Helper & Vendor "Trust Passport" (cross-society reputation) ----
// A worker (maid, cook, electrician, tiffin vendor…) is a NETWORK-WIDE identity
// (no societyId) so their rating & attendance travel across every GateMate
// society. Identity key is the phone number; `code` is encoded into a QR the
// worker carries and any gate can scan.
model Worker {
  id         String   @id @default(uuid())
  name       String
  phone      String   @unique              // identity key across societies
  category   String   @default("helpers")  // helpers|trades|medical|utilities|lifestyle
  subtype    String?                        // "Maid","Electrician","Tiffin"…
  photoUrl   String?
  idProof    String?                        // free note e.g. "Aadhaar verified by A-wing"
  code       String   @unique               // opaque code encoded in the passport QR
  active     Boolean  @default(true)
  createdById String?                        // who first registered them
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  ratings    WorkerRating[]
  attendance WorkerAttendance[]

  @@index([category])
}

// One review of a worker, left by a resident/admin of ANY society. Aggregated on
// read into a portable star rating. One row per (worker, author) — updated in place.
model WorkerRating {
  id        String   @id @default(uuid())
  worker    Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  workerId  String
  societyId String?                         // where the reviewer lives (for "served N societies")
  byUserId  String
  byName    String?
  stars     Int      @default(5)            // 1..5
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workerId, byUserId])
  @@index([workerId])
}

// A worker's gate check-in/out at a society (portable attendance log). Lets a
// guard log the same maid across the societies she serves.
model WorkerAttendance {
  id        String    @id @default(uuid())
  worker    Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  workerId  String
  societyId String
  flatId    String?
  date      String    // "YYYY-MM-DD"
  inAt      DateTime  @default(now())
  outAt     DateTime?
  markedBy  String?
  createdAt DateTime  @default(now())

  @@index([workerId, date])
  @@index([societyId, date])
}

// ---- Tier 3: Asset & AMC tracker (lifts, pumps, DG, fire gear …) -------------
model Asset {
  id               String    @id @default(uuid())
  societyId        String
  name             String
  category         String    @default("other") // lift | pump | dg | fire | water | electrical | other
  location         String?
  vendorName       String?
  vendorPhone      String?
  workerId         String?   // optional link to a rated Trust-Passport vendor
  purchaseDate     DateTime?
  warrantyUntil    DateTime?
  amcVendor        String?
  amcUntil         DateTime?
  serviceEveryDays Int?      // predictive service cadence
  lastServicedAt   DateTime?
  nextServiceAt    DateTime?
  notes            String?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  logs             AssetLog[]

  @@index([societyId, category])
}

model AssetLog {
  id        String   @id @default(uuid())
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assetId   String
  kind      String   @default("service") // service | repair | inspection | note
  cost      Float?
  note      String?
  byId      String?
  byName    String?
  at        DateTime @default(now())

  @@index([assetId, at])
}

// ---- Tier 3: Digital AGM (e-voting, quorum, AI-summarised minutes) -----------
model Meeting {
  id          String    @id @default(uuid())
  societyId   String
  title       String
  agenda      String?
  scheduledAt DateTime?
  quorumPct   Int       @default(50)
  status      String    @default("draft") // draft | open | closed
  minutes     String?   // AI-summarised minutes (audit trail)
  createdById String?
  createdAt   DateTime  @default(now())
  closedAt    DateTime?
  motions     Motion[]
  attendance  MeetingAttendance[]

  @@index([societyId, status])
}

model Motion {
  id        String   @id @default(uuid())
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  meetingId String
  title     String
  detail    String?
  order     Int      @default(0)
  result    String?  // passed | rejected | tie
  votes     Vote[]

  @@index([meetingId])
}

model Vote {
  id        String   @id @default(uuid())
  motion    Motion   @relation(fields: [motionId], references: [id], onDelete: Cascade)
  motionId  String
  flatId    String
  userId    String?
  choice    String   // yes | no | abstain
  createdAt DateTime @default(now())

  @@unique([motionId, flatId])
  @@index([motionId])
}

model MeetingAttendance {
  id        String   @id @default(uuid())
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  meetingId String
  flatId    String
  userId    String?
  at        DateTime @default(now())

  @@unique([meetingId, flatId])
  @@index([meetingId])
}

// ---- Tier 3: Rental compliance loop (verification + checklists + deposit) ----
model RentalCompliance {
  id             String    @id @default(uuid())
  societyId      String
  flatId         String
  agreementId    String?
  policeVerified Boolean   @default(false)
  policeRef      String?
  moveInAt       DateTime?
  moveOutAt      DateTime?
  moveInChecks   Json?     // [{label, done}]
  moveOutChecks  Json?
  depositAmount  Float?
  depositStatus  String    @default("held") // held | partially_returned | returned | forfeited
  depositNote    String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([societyId, flatId])
}

// ---- Tier 3: Sustainability dashboard (per-flat water metering + green score) -
model WaterReading {
  id        String   @id @default(uuid())
  societyId String
  flatId    String
  period    String   // "YYYY-MM"
  litres    Float    @default(0)
  byId      String?
  createdAt DateTime @default(now())

  @@unique([flatId, period])
  @@index([societyId, period])
}
