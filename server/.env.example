PORT=4000
JWT_SECRET=replace-with-a-long-random-string

# Database — PostgreSQL (Supabase in production; used for local dev too).
# Supabase: Project -> Connect -> ORMs/Prisma. URL-encode any special chars in
# the password.
#
# IMPORTANT for concurrency / many simultaneous users: use the TRANSACTION
# POOLER (pgBouncer, port 6543) as DATABASE_URL and append pgbouncer + a
# connection_limit. This lets hundreds of concurrent requests share a small
# pool of real Postgres connections instead of exhausting the database:
#   DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20
# When you switch to the 6543 pooler you MUST also:
#   1) add a DIRECT_URL (port 5432) for schema migrations, AND
#   2) add `directUrl = env("DIRECT_URL")` to the `datasource db` block in
#      prisma/schema.prisma  (migrate/db push can't run through pgBouncer).
#   DIRECT_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
# If you stay on the direct 5432 connection (fine for small deployments), the
# single URL below works for both runtime and migrations.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Late-fee recompute throttle (seconds). Late fees only change day-to-day, so
# the lazy per-society recompute on page loads is throttled to avoid hammering
# the DB under load. Default 1800 (30 min). The exact charge at pay time is
# always recomputed for that one bill regardless of this throttle.
# LATEFEE_THROTTLE_SEC=1800

# Supabase Storage for visitor photos (optional). If unset, the server falls
# back to placeholder avatars so the app still works.
# From Supabase: Project Settings -> API.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_BUCKET=visitors

# Razorpay TEST-mode keys from https://dashboard.razorpay.com (Settings -> API Keys).
# Test keys start with "rzp_test_". No business/KYC needed for test mode.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: only needed if you configure a webhook in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=
# Payouts / revenue split: maintenance and vendor bookings settle to each
# society's own account via Razorpay Route. In the admin app, set the society's
# "Razorpay linked account id" (acc_XXXX, KYC-verified in the Razorpay dashboard
# under Route). Vendor bookings then transfer the society's 90% to that account
# and H2O keeps the 10% platform fee. Without a linked account, the vendor
# payment link still works but the full amount lands on the primary account.

# ------------------------------------------------------------------------------
# AI assistant + voice (optional). Works with any OpenAI-compatible provider.
# Pick ONE of the setups below.
#
# 1) GROQ  — FREE, fast, open-source Llama for chat + Whisper for voice.
#    Get a key at https://console.groq.com (Settings -> API Keys).
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
# AI_CHAT_MODEL=llama-3.3-70b-versatile
# AI_TRANSCRIBE_MODEL=whisper-large-v3
#
# 2) OLLAMA — 100% local/offline, open source, no key (voice NOT supported).
#    Install from https://ollama.com, then `ollama pull llama3.1`.
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=ollama
# AI_CHAT_MODEL=llama3.1
#
# 3) OPENAI — paid. Just set the key; defaults to gpt-4o-mini + whisper-1.
# AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# AI_CHAT_MODEL=gpt-4o-mini
# AI_TRANSCRIBE_MODEL=whisper-1
AI_BASE_URL=
AI_API_KEY=
AI_CHAT_MODEL=
AI_TRANSCRIBE_MODEL=

# ------------------------------------------------------------------------------
# Email (for self-service "Forgot password" OTP codes). OPTIONAL.
# If unset, the server runs in DEV mode: the reset code is printed to the server
# console AND returned by the API so you can test without any provider.
#
# Option A) RESEND (recommended, free tier) — https://resend.com
#   Verify a domain (or use onboarding@resend.dev to send only to your own inbox).
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# EMAIL_FROM=H2O <no-reply@yourdomain.com>
#
# Option B) SMTP (Gmail app password, SendGrid, Mailgun, etc.)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM=H2O <you@gmail.com>
EMAIL_PROVIDER=
EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# ------------------------------------------------------------------------------
# Automated monthly backup. On the last day of each month the server emails a
# full data backup (JSON + CSV attachments) to every society admin.
# In-process schedule runs whenever the server is awake; set to "false" to disable.
BACKUP_CRON_ENABLED=true
# For hosts that sleep (e.g. Render free tier), point an EXTERNAL scheduler at
# POST /api/cron/monthly-backup with header  x-cron-secret: <CRON_SECRET>
# (cron-job.org, Render Cron Job, GitHub Actions, etc.). Set a long random value.
CRON_SECRET=

# ------------------------------------------------------------------------------
# Full-platform disaster-recovery backup (superadmin). Weekly (default Sundays
# 02:00) the server dumps EVERY table, encrypts it, uploads an off-site copy to a
# private Supabase Storage bucket, and emails the owner a checksum + link. Trigger
# on demand from the app (Superadmin -> Backup & recovery) or:
#   POST /api/cron/platform-backup  with header  x-cron-secret: <CRON_SECRET>
# See DISASTER_RECOVERY.md for the restore runbook.
#
# BACKUP_ENCRYPTION_KEY: any strong passphrase. Encrypts the platform dump
# (AES-256-GCM). STORE IT SAFELY — without it the dump cannot be decrypted.
BACKUP_ENCRYPTION_KEY=
# Private bucket for the encrypted dumps (created automatically). Default "backups".
SUPABASE_BACKUP_BUCKET=backups
# In-process weekly schedule; set "false" to disable. Optional cron override.
PLATFORM_BACKUP_CRON_ENABLED=true
# PLATFORM_BACKUP_CRON=0 2 * * 0

# ------------------------------------------------------------------------------
# Scaling / performance (all OPTIONAL — everything works without them).
#
# REDIS_URL: when set, the cache is shared across API instances and the push/
# email queue becomes durable (BullMQ). When unset, the server uses a bounded
# in-process cache + in-process async queue — same behaviour, single instance.
# REDIS_URL=redis://default:password@host:6379
# QUEUE_CONCURRENCY=8
#
# Rate limiting (per IP). Disable entirely with RATE_LIMIT_ENABLED=false.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_MAX=600          # requests / minute across the API
# AUTH_RATE_LIMIT_MAX=40      # login / forgot / reset attempts per 15 min
# AI_RATE_LIMIT_MAX=30        # assistant messages / minute
