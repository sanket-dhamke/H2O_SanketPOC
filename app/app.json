{
  "expo": {
    "name": "GATEZO",
    "slug": "h2o",
    "scheme": "h2o",
    "owner": "sanket2891",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/75b8960c-eda5-41bf-a856-751342266f3b",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#0C4A8C",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.h2o.society"
    },
    "android": {
      "package": "com.h2o.society",
      "versionCode": 31,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-fg.png",
        "backgroundImage": "./assets/adaptive-icon-bg.png",
        "backgroundColor": "#0C4A8C"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#0B6E8F"
        }
      ],
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "cameraPermission": "GATEZO uses the camera so the gate guard can take a photo of the visitor."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "GATEZO uses the microphone so the gate guard can dictate visitor details."
        }
      ],
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0C4A8C"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "apiUrl": "http://localhost:4000",
      "eas": {
        "projectId": "75b8960c-eda5-41bf-a856-751342266f3b"
      }
    }
  }
}
